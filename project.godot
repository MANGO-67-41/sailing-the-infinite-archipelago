; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sailing the Infinite Archipelago"
run/main_scene="res://Sailing the Infinite Archipelago/scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

WindManager="*res://Sailing the Infinite Archipelago/scripts/WindManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2

[shader_globals]

night_amount={
"type": "float",
"value": 0.0
}
ocean_time={
"type": "float",
"value": 0.0
}
ocean_shape={
"type": "vec4",
"value": Vector4(1, 0.16, 0.4, 0)
}
ocean_drift={
"type": "vec2",
"value": Vector2(0, 0)
}
ocean_wave_0={
"type": "vec4",
"value": Vector4(0.9439, 0.3304, 38, 0.42)
}
ocean_wave_1={
"type": "vec4",
"value": Vector4(-0.3714, 0.9285, 22, 0.24)
}
ocean_wave_2={
"type": "vec4",
"value": Vector4(0.6644, -0.7474, 13, 0.11)
}
ocean_calm={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
ocean_wave_3={
"type": "vec4",
"value": Vector4(-0.9806, -0.1961, 7.5, 0.05)
}
